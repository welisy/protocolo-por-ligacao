    {
      "parameters": {
        "url": "={{ $json.config.telefoniaUrl }}/api/v1/calls/{{ $json.body.correlation_id }}/info",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
