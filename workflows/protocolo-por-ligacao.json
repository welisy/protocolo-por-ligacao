      "parameters": {
        "jsCode": "// ===== Configuração =====\n// Tudo que muda de um ambiente para outro fica aqui. Tokens NÃO: ficam nas credenciais do n8n.\n// mapaAgentes e agentesExcluidos saem prontos do workflow \"Gerar mapa de agentes\".\nconst config = {\n  telefoniaUrl: 'https://telefonia.exemplo.com',\n  helpdeskUrl: 'https://helpdesk.exemplo.com',\n  helpdeskTenant: 'exemplo',\n  clienteId: '2',                       // empresa padrão do ticket no helpdesk\n  servicoId: '39',                      // serviço / categoria do ticket\n  dominioContato: 'ura.exemplo.local',  // e-mail sintético do contato: <cpf>@<dominio>\n\n  // Agentes que não geram protocolo (ex.: equipe de cobrança).\n  agentesExcluidos: ['53', '54'],\n\n  // Agente da telefonia -> responsável (r) e equipe (t) no helpdesk.\n  mapaAgentes: {\n    '10': { r: '700', t: '1' },\n    '11': { r: '704', t: '10' },\n    '12': { r: '705', t: '1' },\n  },\n\n  janelaLigacaoMin: 30,   // quanto tempo as pernas de uma mesma ligação ficam agrupadas\n  reservaMaxSeg: 60,      // reserva sem ticket além disso = perna que falhou\n  esperaSeg: 5,           // espera entre tentativas da perna que aguarda o ticket\n  tentativasMax: 6,       // 6 x 5 s = até 30 s esperando a perna anterior\n};\n\nreturn [{ json: { ...$json, config } }];\n"
      },
