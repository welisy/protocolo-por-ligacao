      "parameters": {
        "jsCode": "// Grava o id do ticket na reserva feita pelo Anti-duplicado, para a perna seguinte\n// da mesma ligação encontrar o ticket e ATUALIZAR em vez de criar outro.\nconst ticket = $json;\nconst chave = String($('Prepara Chamada').first().json.telefone || '');\nconst estado = $getWorkflowStaticData('global');\nestado.ligacoes = estado.ligacoes || {};\nif (chave) estado.ligacoes[chave] = { ticket_id: String(ticket.id || ''), ts: Date.now() };\nreturn [{ json: ticket }];\n"
      },
