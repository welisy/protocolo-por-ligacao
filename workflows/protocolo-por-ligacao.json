      "id": "dca71e57-bbbd-5f7f-bc55-1288f9ab3c2b",
      "name": "Busca Dados da Chamada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        660,
        300
      ],
      "retryOnFail": true,
      "waitBetweenTries": 500
    },
    {
      "parameters": {
        "jsCode": "// Junta o evento do webhook com os dados da chamada (CPF e empresa digitados na URA).\nconst { body = {}, config } = $('Config').first().json;\n\nlet cpf = '', empresa = '';\ntry {\n  const info = $input.first().json;\n  // a API devolve { data: \"<json em texto>\" } com call_info: [{ label, value }]\n  const dados = typeof info.data === 'string' ? JSON.parse(info.data) : (info.data || info);\n  for (const campo of (dados.call_info || [])) {\n    const label = String(campo.label || '').toLowerCase();\n    if (label === 'cpf') cpf = String(campo.value ?? '');\n    if (label === 'empresa') empresa = String(campo.value ?? '');\n  }\n} catch (e) {}\n\nlet cpfDigitos = cpf.replace(/\\D/g, '');\nconst telefone = String(body.caller_number || '');\n\n// Na transferência assistida, a 2ª perna tem outro correlation_id e a consulta não traz o CPF.\n// O elo entre as pernas é o telefone de quem ligou: guarda o CPF quando vem e recupera quando falta.\nconst estado = $getWorkflowStaticData('global');\nestado.cpfPorTelefone = estado.cpfPorTelefone || {};\nconst agora = Date.now();\nconst janela = config.janelaLigacaoMin * 60 * 1000;\nfor (const k of Object.keys(estado.cpfPorTelefone)) {\n  if (agora - estado.cpfPorTelefone[k].ts > janela) delete estado.cpfPorTelefone[k];\n}\nif (/^\\d{11}$/.test(cpfDigitos)) {\n  if (telefone) estado.cpfPorTelefone[telefone] = { cpf: cpfDigitos, empresa, ts: agora };\n} else if (telefone && estado.cpfPorTelefone[telefone]) {\n  cpfDigitos = estado.cpfPorTelefone[telefone].cpf;\n  empresa = empresa || estado.cpfPorTelefone[telefone].empresa || '';\n}\n\nconst agente = String(body.agent_id || '');\nreturn [{ json: {\n  telefone,\n  telefone_sem_ddi: telefone.replace(/^55/, ''),\n  agente,\n  excluido: config.agentesExcluidos.map(String).includes(agente),\n  cpf: cpfDigitos || 'não informado',\n  cpf_valido: /^\\d{11}$/.test(cpfDigitos),\n  empresa: empresa ? empresa.toUpperCase() : 'não informado',\n  correlation_id: String(body.correlation_id || ''),\n  call_uuid: String(body.call_uuid || ''),\n  timestamp: String(body.timestamp || ''),\n} }];\n"
      },
