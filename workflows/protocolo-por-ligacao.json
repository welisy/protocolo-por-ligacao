      "id": "f3c087ea-8f74-5da2-902f-2640b28f47ca",
      "name": "Gera Protocolo?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1 protocolo por LIGAÇÃO, no agente que RECEBEU.\n//\n// Chave = telefone de quem ligou. É o único elo entre as pernas: na transferência assistida\n// cada perna chega com um correlation_id próprio, então agrupar por ele gera ticket duplicado.\n//\n// Saída no campo `acao`:\n//   criar     primeira perna da ligação\n//   atualizar perna seguinte: troca o responsável do ticket que já existe\n//   aguardar  a perna anterior ainda está criando o ticket; espera e tenta de novo\nconst { config } = $('Config').first().json;\nconst p = $json;\nconst chave = String(p.telefone || '');\nconst estado = $getWorkflowStaticData('global');\nestado.ligacoes = estado.ligacoes || {};\n\nconst agora = Date.now();\nconst JANELA = config.janelaLigacaoMin * 60 * 1000;\nconst RESERVA_MAX = config.reservaMaxSeg * 1000;\n\nfor (const k of Object.keys(estado.ligacoes)) {\n  if (agora - estado.ligacoes[k].ts > JANELA) delete estado.ligacoes[k];\n}\n\nconst tentativas = Number(p._tentativas || 0);\nconst saida = (acao, ticketId, t) => [{ json: { ...p, acao, ticket_id: String(ticketId || ''), _tentativas: t } }];\n\nif (!chave) return saida('criar', '', tentativas);       // sem telefone não dá para agrupar\n\nconst reg = estado.ligacoes[chave];\n\n// Primeira perna: reserva a chave na hora. As pernas chegam com ~1 s de diferença, menos\n// que o tempo de criar o ticket, então a seguinte precisa enxergar a ligação em andamento.\nif (!reg) {\n  estado.ligacoes[chave] = { ticket_id: '', ts: agora };\n  return saida('criar', '', tentativas);\n}\n\n// Já tem ticket: atualiza. O ts é renovado a cada perna (janela deslizante) para\n// aguentar ligação longa com várias transferências.\nif (reg.ticket_id) {\n  reg.ts = agora;\n  return saida('atualizar', reg.ticket_id, tentativas);\n}\n\n// Reserva órfã (a perna anterior falhou antes de criar) ou espera longa demais:\n// melhor um ticket a mais do que uma ligação sem protocolo.\nif (tentativas >= config.tentativasMax || (agora - reg.ts) > RESERVA_MAX) {\n  estado.ligacoes[chave] = { ticket_id: '', ts: agora };\n  return saida('criar', '', tentativas);\n}\n\nreturn saida('aguardar', '', tentativas + 1);\n"
      },
      "id": "6e32ba75-5870-5331-b4ca-fe8b800afb14",
      "name": "Anti-duplicado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agente da telefonia -> responsável + equipe no helpdesk (mapa no nó Config).\nconst { config } = $('Config').first().json;\n\n// O helpdesk faz FIND-OR-CREATE nesses campos: valor não numérico não dá erro, ele CRIA\n// uma equipe ou um responsável com aquele texto de nome. Daqui para frente, só dígitos.\nconst num = (v) => /^\\d+$/.test(String(v ?? '')) ? String(v) : '';\n\nconst p = $json;\nconst m = config.mapaAgentes[String(p.agente)] || {};\nconst r = num(m.r), t = num(m.t);\nconst ok = Boolean(r && t);   // o responsável precisa da equipe dele; sem os dois, fica sem dono (fila do serviço)\n\n// Num ticket que já existe, enviar o campo vazio APAGA o responsável atual.\n// Sem agente resolvido, a perna seguinte não encosta no ticket.\nconst acao = (p.acao === 'atualizar' && !ok) ? 'ignorar' : p.acao;\n\nreturn [{ json: { ...p, acao, responsible_id: ok ? r : '', team_id: ok ? t : '' } }];\n"
      },
